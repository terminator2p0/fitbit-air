# Application
APP_URL=http://localhost:3000
APP_TIMEZONE=America/New_York

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_health

# Google Health OAuth
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
