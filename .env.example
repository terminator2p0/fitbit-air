# Generate a long random value before local use.
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# Food reminder email; optional until reminder implementation.
REMINDER_EMAIL_FROM=
REMINDER_EMAIL_TO=
SMTP_URL=
