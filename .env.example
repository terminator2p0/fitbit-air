# Application
APP_URL=http://localhost:3000
APP_TIMEZONE=America/New_York

# Google Cloud / Firestore
# Use demo-fitbit-air with the local emulator. Use the real project ID in cloud.
GOOGLE_CLOUD_PROJECT=demo-fitbit-air
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Required only for direct cloud access outside Cloud Run. Emulator mode enables itself.
FIRESTORE_ENABLED=false

# Google Health OAuth
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/api/auth/google-health/callback

# Generate a base64-encoded 32-byte key before OAuth use.
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# Food reminder email; optional until reminder implementation.
REMINDER_EMAIL_FROM=
REMINDER_EMAIL_TO=
SMTP_URL=
